# Copy to .env. Never commit .env.

# Model provider: anthropic or deepseek. Only the key for the chosen provider is needed.
LLM_PROVIDER=anthropic
# Cheap default for day-to-day use. Use claude-sonnet-5-5 for the demo video and published evals.
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Spending caps (USD).
DAILY_CHAT_BUDGET_USD=0.50
EVAL_RUN_BUDGET_USD=1.00

# Shared secret between the Go API and the agent service. Change it.
INTERNAL_TOKEN=change-me-local-internal-token
# Lets the eval harness bypass the chat cap (evals have their own budget).
EVAL_TOKEN=change-me-local-eval-token

# runsc = gVisor (stronger isolation). Falls back to runc if gVisor is not installed.
SANDBOX_RUNTIME=runsc

POSTGRES_PASSWORD=daa
