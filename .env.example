# Copy to .env. Never commit .env.

# Model provider: anthropic or deepseek. Only the key for the chosen provider is needed.
LLM_PROVIDER=deepseek
# Cheap default, and the model the published eval scores come from.
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Optional: switch to Claude with LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Spending caps (USD).
DAILY_CHAT_BUDGET_USD=0.50
EVAL_RUN_BUDGET_USD=1.00

# Shared secret between the Go API and the agent service. Change it.
INTERNAL_TOKEN=change-me-local-internal-token
# Lets the eval harness bypass the chat cap (evals have their own budget).
EVAL_TOKEN=change-me-local-eval-token

# Plain Docker (runc) is the default. Set runsc to use gVisor if you have installed it.
SANDBOX_RUNTIME=runc

POSTGRES_PASSWORD=daa

# Tracing is off by default. `make up-tracing` starts Arize Phoenix on http://localhost:6006 and turns it on
# for both the api and the agent. Set true to keep prompts, SQL, Python and tool output off the spans
# (timings, tokens, statuses and ids are still recorded).
TRACING_HIDE_PAYLOADS=false
